{
  "name": "@finx/desktop",
  "productName": "FinxWork",
  "private": true,
  "version": "0.1.0",
  "description": "finxwork: the desktop app for the finx agent kernel",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-agent-desktop.mjs && electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "build": "node scripts/dev-agent-desktop.mjs && electron-vite build",
    "start": "electron-vite preview",
    "app": "node scripts/build-app.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test src/renderer/src/docs/pptx/*.test.ts src/renderer/src/docs/docx/*.test.ts src/renderer/src/docs/pptx/commands/*.test.ts src/renderer/src/docs/*.test.ts src/renderer/src/docs/sheet/*.test.ts src/renderer/src/files/*.test.ts src/shared/*.test.ts src/main/*.test.ts src/main/kernel/*.test.ts src/main/browser/*.test.ts src/main/docx/*.test.ts src/renderer/src/composer/*.test.ts scripts/*.test.mjs src/renderer/src/session/markdown/*.test.ts",
    "verify": "node e2e/run.mjs",
    "e2e": "node e2e/stale-model.mjs",
    "e2e:pptx": "node e2e/pptx-editor.mjs",
    "e2e:pptx-text": "FINXWORK_E2E_NATIVE=1 FINXWORK_E2E_TEXT_LAYOUT=1 node e2e/pptx-editor.mjs",
    "e2e:pptx-panel": "node e2e/pptx-panel.mjs",
    "e2e:chatgpt": "node e2e/chatgpt.mjs",
    "e2e:markdown": "node e2e/markdown.mjs",
    "e2e:conversation": "node e2e/conversation.mjs"
  },
  "dependencies": {
    "@betteroffice/docx": "0.5.1-finx.gaac46417",
    "@betteroffice/docx-i18n": "0.5.1-finx.gaac46417",
    "@betteroffice/docx-react": "0.5.1-finx.gaac46417",
    "@betteroffice/fonts": "0.5.1-finx.gaac46417",
    "@betteroffice/pptx": "0.5.1-finx.gaac46417",
    "@betteroffice/pptx-i18n": "0.5.1-finx.gaac46417",
    "@betteroffice/pptx-react": "0.5.1-finx.gaac46417",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@finx/client": "workspace:*",
    "@finx/protocol": "workspace:*",
    "@lexical/react": "0.52.0",
    "@lexical/text": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-virtual": "3.14.25",
    "i18next": "26.4.2",
    "katex": "0.16.47",
    "lexical": "0.52.0",
    "lucide-react": "1.67.0",
    "mermaid": "12.3.0",
    "pdfjs-dist": "5.4.394",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.15",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remend": "1.4.0",
    "shiki": "4.5.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.7.1",
    "@electron/packager": "20.3.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-vite": "6.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "micromark-util-types": "2.0.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
