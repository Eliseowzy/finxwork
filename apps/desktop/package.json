{
  "name": "@finx/desktop",
  "productName": "FinxWork",
  "private": true,
  "version": "0.1.0",
  "description": "finxwork: the desktop app for the finx agent kernel",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-agent-desktop.mjs && electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "build": "node scripts/dev-agent-desktop.mjs && electron-vite build",
    "start": "electron-vite preview",
    "app": "node scripts/build-app.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test src/shared/*.test.ts src/main/*.test.ts src/main/kernel/*.test.ts src/main/browser/*.test.ts src/renderer/src/composer/*.test.ts scripts/*.test.mjs",
    "e2e": "node e2e/stale-model.mjs",
    "e2e:chatgpt": "node e2e/chatgpt.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@finx/client": "workspace:*",
    "@finx/protocol": "workspace:*",
    "@lexical/react": "0.52.0",
    "@lexical/text": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-virtual": "3.14.25",
    "i18next": "26.4.2",
    "lexical": "0.52.0",
    "lucide-react": "1.67.0",
    "pdfjs-dist": "5.4.394",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.15",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remend": "1.4.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.7.1",
    "@electron/packager": "20.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
